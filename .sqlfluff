[sqlfluff]
dialect = snowflake
templater = raw
max_line_length = 120

# Rules intentionally disabled for this project:
#   CP02 - unquoted identifier capitalisation: mixed-case columns like
#          event_id read more naturally than EVENT_ID for a portfolio repo
#   LT02/LT01 - strict indent/spacing rules that fight this file's manual
#               alignment of column definitions, which is more readable
#               than sqlfluff's auto-format for a DDL file like this
#   LT09     - forces every multi-column SELECT onto separate lines, too
#              noisy for this file's short convenience views
exclude_rules = CP02, LT01, LT02, LT09